{
	"name": "claude-parallel-profiles-website",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "node scripts/preview.mjs",
		"preview": "npm run build && node scripts/preview.mjs",
		"lint": "eslint .",
		"typecheck": "next typegen && tsc --noEmit",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,jsx,css,md,json}\" --cache",
		"format:write": "prettier --write \"**/*.{ts,tsx,js,mjs,jsx,css,md,json}\" --cache"
	},
	"engines": {
		"node": ">=20.9.0"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"clsx": "^2.1.1",
		"next": "^16.3.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.3.6",
		"postcss": "^8.5.28",
		"prettier": "^3.9.9",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.1"
	}
}
